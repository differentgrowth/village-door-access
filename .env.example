# Template for host env (Vercel Production) and local copies.
# Do not commit a real .env.
#
# Local Docker (postgres:16, same as CI) — put these in .env.development.local:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/village
#   DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/village
#
# ADMIN_PASSWORD: at least 8 characters; letters, digits, and symbols allowed.

DATABASE_URL=
# Optional. Direct (non-pooler) URL for `prisma migrate deploy`.
# The Vercel Neon integration sets this as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional. Both NOTIFY_EMAIL and RESEND_API_KEY are required to send Notices.
NOTIFY_EMAIL=
RESEND_API_KEY=
NOTIFY_FROM=
