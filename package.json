{
  "name": "village-door-access",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source village door access: Visitors record a Visit and see that Location's Access Code. Operators share one Password.",
  "homepage": "https://github.com/differentgrowth/village-door-access#readme",
  "bugs": {
    "url": "https://github.com/differentgrowth/village-door-access/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/differentgrowth/village-door-access.git"
  },
  "license": "MIT",
  "author": "Village Door Access / Different Growth",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "prisma generate && pnpm db:migrate && vite build",
    "build:dev": "vite build --mode development",
    "check": "biome check --write --unsafe",
    "db:migrate": "prisma migrate deploy",
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "postinstall": "prisma generate",
    "lint": "biome lint",
    "prepare": "husky",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "test": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "write": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.28.0",
    "lint-staged": "^17.3.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prisma": "^7.9.1",
    "typescript": "^5.7.0",
    "ultracite": "7.10.5",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@11.21.0"
}
